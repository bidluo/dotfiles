{
  "document": { "color": "#e0e0e0", "margin": 1, "block_prefix": "\n", "block_suffix": "\n" },
  "paragraph": {},
  "block_quote": { "color": "#a0a0a0", "indent": 1, "indent_token": "│ " },
  "list": { "level_indent": 2 },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "heading": { "color": "#ffc799", "bold": true, "block_suffix": "\n" },
  "h1": { "prefix": " ", "suffix": " ", "color": "#101010", "background_color": "#ffc799", "bold": true },
  "h2": { "prefix": "▍ " },
  "h3": { "prefix": "▍ ", "color": "#99ffe4" },
  "h4": { "prefix": "▍ ", "color": "#a0a0a0" },
  "h5": { "prefix": "▍ ", "color": "#a0a0a0" },
  "h6": { "prefix": "▍ ", "color": "#7e7e7e" },
  "strong": { "bold": true, "color": "#ffffff" },
  "emph": { "italic": true },
  "strikethrough": { "crossed_out": true },
  "hr": { "color": "#3a3a3a", "format": "\n────────\n" },
  "link": { "color": "#ffc799", "underline": true },
  "link_text": { "color": "#ffc799", "bold": true },
  "code": { "prefix": " ", "suffix": " ", "color": "#99ffe4", "background_color": "#1c1c1c" },
  "code_block": {
    "color": "#e0e0e0",
    "margin": 2,
    "chroma": {
      "text": { "color": "#e0e0e0" },
      "comment": { "color": "#7e7e7e", "italic": true },
      "keyword": { "color": "#ffc799" },
      "name_builtin": { "color": "#ffc799" },
      "name_function": { "color": "#ffc799" },
      "name_tag": { "color": "#ffc799" },
      "name_attribute": { "color": "#a0a0a0" },
      "literal_string": { "color": "#99ffe4" },
      "literal_number": { "color": "#ffc799" },
      "operator": { "color": "#a0a0a0" },
      "punctuation": { "color": "#a0a0a0" },
      "generic_deleted": { "color": "#ff8080" },
      "generic_inserted": { "color": "#99ffe4" },
      "error": { "color": "#ff8080" }
    }
  },
  "table": { "center_separator": "┼", "column_separator": "│", "row_separator": "─" },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " }
}
