# mako notification daemon
#
# NOTE ON "FADE": mako has no fade/animation support at all — there is no
# opacity, fade, animation or transition option in the binary or the man page.
# Notifications appear and disappear instantly. What is configured here is
# auto-dismissal on a timeout, which was the actual problem: the shipped
# default-timeout is 0, meaning notifications never expired and simply piled up.
#
# Auto-dismiss is only safe because history is enlarged well past the default
# of 5 and bound to a key — see Cmd+Ctrl+N / Cmd+Ctrl+Shift+N in hyprland.lua.

# --- behaviour ---
default-timeout=5000
ignore-timeout=0
max-history=200
max-visible=5
sort=-time
group-by=app-name

# --- placement ---
anchor=top-right
layer=overlay
margin=10
outer-margin=10,10
padding=12
width=380
height=160

# --- look, matching waybar and the Hyprland border accent ---
font=JetBrainsMono Nerd Font 10
background-color=#1a1a1aeb
text-color=#eeeeeeff
border-color=#33ccffaa
border-size=2
border-radius=10
progress-color=over #33ccff44
icons=1
max-icon-size=48
markup=1
format=<b>%s</b>\n%b

[urgency=low]
border-color=#59595988
text-color=#bbbbbbff
default-timeout=3000

[urgency=normal]
border-color=#33ccffaa
default-timeout=5000

# Critical notifications never auto-dismiss — this is the safety valve that
# makes timing out the other two levels reasonable.
[urgency=critical]
border-color=#ff5555ff
text-color=#ffffffff
default-timeout=0
