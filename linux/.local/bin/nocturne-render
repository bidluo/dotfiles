#!/usr/bin/env python3
"""nocturne-render — render the user's matugen templates from DMS's palette.

DMS generates ~/.local/state/DankMaterialShell/dms-colors.json (all Material
roles + the dank16 ANSI palette) on every theme change, but its CLI does not
reliably run user templates from ~/.config/matugen/config.toml. So we render
them ourselves: config.toml is the manifest (input_path/output_path per
template), and the placeholders are resolved from dms-colors.json.

Supported placeholders (matugen-compatible subset):
    {{colors.<role>.default.hex}}        {{colors.<role>.default.hex_stripped}}
    {{dank16.colorN.default.hex}}        {{dank16.colorN.default.hex_stripped}}

Usage: nocturne-render [--mode dark|light]
"""
import json
import os
import re
import sys
import tomllib

STATE = os.path.expanduser("~/.local/state/DankMaterialShell/dms-colors.json")
CONFIG = os.path.expanduser("~/.config/matugen/config.toml")

mode = "dark"
if "--mode" in sys.argv:
    mode = sys.argv[sys.argv.index("--mode") + 1]

try:
    data = json.load(open(STATE))
except FileNotFoundError:
    sys.exit(f"nocturne-render: {STATE} not found — run a DMS theme generation first")

colors = data["colors"][mode]
dank16 = data["dank16"]

PLACEHOLDER = re.compile(r"\{\{\s*([a-zA-Z0-9_.]+)\s*\}\}")


def resolve(expr: str) -> str:
    parts = expr.split(".")
    stripped = parts[-1] == "hex_stripped"
    if parts[0] == "colors":
        val = colors.get(parts[1])
    elif parts[0] == "dank16":
        entry = dank16.get(parts[1], {})
        val = entry.get(mode) or entry.get("default")
    else:
        val = None
    if val is None:
        raise KeyError(f"unresolved placeholder: {expr}")
    return val.lstrip("#") if stripped else val


def render(text: str) -> str:
    return PLACEHOLDER.sub(lambda m: resolve(m.group(1)), text)


with open(CONFIG, "rb") as f:
    manifest = tomllib.load(f)

count = 0
for name, spec in manifest.get("templates", {}).items():
    ip = os.path.expanduser(spec["input_path"])
    op = os.path.expanduser(spec["output_path"])
    try:
        with open(ip) as f:
            out = render(f.read())
    except (FileNotFoundError, KeyError) as e:
        print(f"  ✗ {name}: {e}", file=sys.stderr)
        continue
    os.makedirs(os.path.dirname(op), exist_ok=True)
    with open(op, "w") as f:
        f.write(out)
    print(f"  ✓ {name} → {op}")
    count += 1

print(f"nocturne-render: {count} template(s) written ({mode})")
